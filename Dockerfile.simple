FROM node:20-alpine AS builder

# Build arguments - эти переменные должны быть настроены в ТаймВеб
ARG VITE_API_URL=https://api.keykurs.ru
ARG VITE_VK_CLIENT_ID=54463778

# Устанавливаем их как ENV для доступа во время сборки
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_VK_CLIENT_ID=${VITE_VK_CLIENT_ID}

WORKDIR /app

# Копируем package файлы и устанавливаем зависимости
COPY package*.json ./
RUN npm ci

# Копируем весь код
COPY . .

# Показываем переменные для отладки
RUN echo "==================================" && \
    echo "Building with:" && \
    echo "VITE_API_URL=${VITE_API_URL}" && \
    echo "VITE_VK_CLIENT_ID=${VITE_VK_CLIENT_ID}" && \
    echo "=================================="

# Собираем приложение
RUN npm run build

# Production stage - используем nginx для раздачи статики
FROM nginx:alpine

# Копируем собранные файлы
COPY --from=builder /app/dist /usr/share/nginx/html

# Копируем конфигурацию nginx
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
