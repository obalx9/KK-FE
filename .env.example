# URL вашего бэкенда (БЕЗ порта - ТаймВеб использует reverse proxy)
# Пример: https://api.keykurs.ru
VITE_API_URL=https://api.keykurs.ru

# Client ID вашего приложения ВКонтакте для OAuth авторизации
# Получить можно в настройках приложения на vk.com/apps
VITE_VK_CLIENT_ID=54463778

# ВАЖНО: Эти переменные должны быть настроены в ТаймВеб как Global Environment Variables
# для Docker приложения frontend. Они будут автоматически встроены в JavaScript
# файлы на этапе сборки через скрипт generate-env.sh
